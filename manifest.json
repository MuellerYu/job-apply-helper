{
  "manifest_version": 3,
  "name": "求职自动投递助手",
  "version": "2.3.291",
  "description": "在招聘网站上自动上传简历、按你的资料填写申请表、逐页推进，停在提交前。配合本机 Codex 可以补答新题、复核、写 cover letter。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "nativeMessaging",
    "debugger",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "求职自动投递助手：打开设置"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
